# 环境变量示例文件

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=study_platform
DB_USER=root
DB_PASSWORD=root

# 服务器配置
PORT=3000
NODE_ENV=development

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here

# 日志配置
LOG_LEVEL=info

# 上传文件配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS 配置
CORS_ORIGIN=http://localhost:3000
