# 环境变量配置示例文件
# 复制此文件为 .env 并填写实际配置

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=study_platform
DB_USER=root
DB_PASSWORD=your_database_password

# 服务器配置
PORT=8080
NODE_ENV=development

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# 日志配置
LOG_LEVEL=info

# 数据初始化配置
SEED_ADMIN=true
ADMIN_SEED_PASSWORD=123456
SEED_DASHBOARD=false

# 上传文件配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 数据库同步配置（开发环境使用）
DB_SYNC_ALTER=true