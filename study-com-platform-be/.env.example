# 环境变量配置示例文件
# 复制此文件为 .env 并填写实际配置

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=study_platform
DB_USER=root
DB_PASSWORD=your_database_password

# 服务器配置
PORT=8081
NODE_ENV=development

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# 日志配置
LOG_LEVEL=info

# 数据初始化配置
SEED_ADMIN=true
ADMIN_SEED_PASSWORD=123456
SEED_DASHBOARD=false

# 上传文件配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 数据库同步配置（开发环境使用）
DB_SYNC_ALTER=true

# 阿里云 OSS 配置（可选，如果不配置则使用本地存储）
# 注意：OSS_ACCESS_KEY_ID 和 OSS_ACCESS_KEY_SECRET 建议通过系统环境变量设置
# 以避免硬编码在配置文件中
# OSS_REGION=oss-cn-beijing
# OSS_BUCKET=weblog-dev
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# OSS_DOMAIN=weblog-dev.oss-cn-beijing.aliyuncs.com
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret