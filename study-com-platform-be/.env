# 环境变量配置

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=study_platform
DB_USER=root
DB_PASSWORD=123456

# 服务器配置
PORT=8081
NODE_ENV=development

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here

# 日志配置
LOG_LEVEL=info

SEED_ADMIN=true
ADMIN_SEED_PASSWORD=123456
# 上传文件配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS 配置
CORS_ORIGIN=http://localhost:5173

# 时区配置
TZ=Asia/Shanghai